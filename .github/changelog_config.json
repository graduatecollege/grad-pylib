{
    "mode": "COMMIT",
    "template": "#{{CHANGELOG}}",
    "commit_template": "- #{{RELEASE_NOTE}} ([#{{SHORT_SHA}}](https://github.com/#{{OWNER}}/#{{REPO}}/commit/#{{MERGE_SHA}}))",
    "categories": [
        {
            "title": "## Features",
            "labels": ["feat"]
        },
        {
            "title": "## Bug Fixes",
            "labels": ["fix"]
        }
    ],
    "custom_placeholders": [
        {
            "name": "RELEASE_NOTE",
            "source": "BODY",
            "transformer": {
                "pattern": "^[^\\n]*\\n+([\\s\\S]*?)(?:\\n+Co-authored-by:.*)?$",
                "target": "$1"
            }
        },
        {
            "name": "SHORT_SHA",
            "source": "MERGE_SHA",
            "transformer": {
                "pattern": "^(.{7}).*$",
                "target": "$1"
            }
        }
    ],
    "label_extractor": [
        {
            "pattern": "^(feat|fix)(?:\\([^)]+\\))?!?:.*$",
            "target": "$1",
            "on_property": "title"
        }
    ],
    "empty_template": "# Release Notes\n\nInternal maintenance and minor updates.",
    "options": {
        "commits_as_entries": true
    }
}
